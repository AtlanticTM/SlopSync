# Build output. Per-tree build dirs are listed explicitly: a bare `build/`
# rule silently swallows docs-site/docs/build/ (authored pages, not build
# product) — the same trap SlopDrive-32's Phase G pass had to fix.
.pio/
/build/
hub/slopbench/build/
test/fuzz/build/
*.o
*.obj
bin/
obj/

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/

# docs-site build product
site/

# Editor/OS cruft
.vscode/
.DS_Store

# clangd index + host-specific LSP config (absolute paths)
.clangd
.cache/
compile_commands.json
